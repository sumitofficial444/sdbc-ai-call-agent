# Copy this file to backend/.env. Never put API keys in frontend variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
PORT=8080
# For the full MERN stack, start local MongoDB and uncomment:
# MONGODB_URI=mongodb://127.0.0.1:27017/sdbc_voice
# With no URI, the demo explicitly uses a local JSON file, not MongoDB.
LEAD_STORE=file
